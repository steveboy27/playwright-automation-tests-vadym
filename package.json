{
  "name": "playwright-automation-tests-vadym",
  "version": "1.0.0",
  "private": true,
  "description": "SauceDemo web E2E, API contract examples, and human-reviewed AI-assisted QA workflows using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "audit:ai": "node scripts/audit-test-quality.mjs",
    "check": "npm run typecheck && npm run audit:ai"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {"node": ">=20"}
}
